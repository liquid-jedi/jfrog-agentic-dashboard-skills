{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/ciso-report-guardrail-codex.sh",
            "timeout": 10,
            "statusMessage": "Checking CISO report command safety"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/ciso-report-guardrail-codex.sh",
            "timeout": 10,
            "statusMessage": "Checking CISO report permission request"
          }
        ]
      }
    ]
  }
}
